<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Определение переменной LOG_PATH -->
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_ARCHIVE" value="${LOG_PATH}/archive" />

    <!-- Аппендер для консоли -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Аппендер для записи в файл (с ротацией по дням) -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/parser.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- archive log files daily -->
            <fileNamePattern>${LOG_ARCHIVE}/parser-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- keep 30 days of history -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Корневой уровень логирования -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </root>

    <!-- Специфичные настройки для Spring/Томката (чтобы не заспамить логи) -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="com.letisim" level="DEBUG"/> <!-- Включаем DEBUG для нашего пакета -->

</configuration>
