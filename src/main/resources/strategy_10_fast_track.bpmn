  <bpsim:BPSimData xmlns:bpsim="http://www.bpsim.org/schemas/2.0" xsi:schemaLocation="http://www.bpsim.org/schemas/2.0 bpsim.xsd">
    <bpsim:Scenario id="scenario_be97dda0-8fa1-435c-92c3-9645a889c10a" name="Default Scenario">
      <bpsim:ScenarioParameters baseCurrency="USD" baseTimeUnit="HOURS" processInstances="100">
        <bpsim:Duration>
          <bpsim:FloatingParameter>
            <bpsim:Value>24.0</bpsim:Value>
          </bpsim:FloatingParameter>
        </bpsim:Duration>
        <bpsim:WarmupPeriod>
          <bpsim:FloatingParameter>
            <bpsim:Value>0.0</bpsim:Value>
          </bpsim:FloatingParameter>
        </bpsim:WarmupPeriod>
        <bpsim:ResultInterval>
          <bpsim:FloatingParameter>
            <bpsim:Value>1.0</bpsim:Value>
          </bpsim:FloatingParameter>
        </bpsim:ResultInterval>
        <bpsim:CumulativeResults>true</bpsim:CumulativeResults>
      </bpsim:ScenarioParameters>
      <bpsim:ResourceParameters>
        <bpsim:ResourceParameter name="OperatorTeam" resourceId="Res_Operator">
          <bpsim:Quantity>
            <bpsim:FloatingParameter>
              <bpsim:Value>1</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:Quantity>
          <bpsim:CalendarRef>WORK_CAL</bpsim:CalendarRef>
          <bpsim:CostPerHour>
            <bpsim:FloatingParameter>
              <bpsim:Value>7</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:CostPerHour>
        </bpsim:ResourceParameter>
        <bpsim:ResourceParameter name="RiskEngine" resourceId="Res_Risk">
          <bpsim:Quantity>
            <bpsim:FloatingParameter>
              <bpsim:Value>1</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:Quantity>
          <bpsim:CalendarRef>WORK_CAL</bpsim:CalendarRef>
          <bpsim:CostPerHour>
            <bpsim:FloatingParameter>
              <bpsim:Value>7</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:CostPerHour>
        </bpsim:ResourceParameter>
        <bpsim:ResourceParameter name="ManagerTeam" resourceId="Res_Manager">
          <bpsim:Quantity>
            <bpsim:FloatingParameter>
              <bpsim:Value>1</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:Quantity>
          <bpsim:CalendarRef>WORK_CAL</bpsim:CalendarRef>
          <bpsim:CostPerHour>
            <bpsim:FloatingParameter>
              <bpsim:Value>8</bpsim:Value>
            </bpsim:FloatingParameter>
          </bpsim:CostPerHour>
        </bpsim:ResourceParameter>
      </bpsim:ResourceParameters>
      <bpsim:ElementParameters>
        <bpsim:ElementParameter elementRef="Task_Risk">
          <bpsim:TimeParameters>
            <bpsim:Duration>
              <bpsim:FloatingParameter>
                <bpsim:BetaDistribution alpha="3.0" beta="3.0" />
              </bpsim:FloatingParameter>
            </bpsim:Duration>
          </bpsim:TimeParameters>
          <bpsim:CostParameters>
            <bpsim:FixedCost>
              <bpsim:FloatingParameter>
                <bpsim:Value>33</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:FixedCost>
          </bpsim:CostParameters>
          <bpsim:ResourceParameters>
            <bpsim:ResourceAssignmentExpression>
              <bpsim:Expression>
                <bpsim:StringParameter>
                  <bpsim:Value>Res_Operator</bpsim:Value>
                </bpsim:StringParameter>
              </bpsim:Expression>
            </bpsim:ResourceAssignmentExpression>
          </bpsim:ResourceParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="Task_Reject">
          <bpsim:TimeParameters>
            <bpsim:Duration>
              <bpsim:FloatingParameter>
                <bpsim:LogNormalDistribution mean="7.0" standardDeviation="2.0" />
              </bpsim:FloatingParameter>
            </bpsim:Duration>
          </bpsim:TimeParameters>
          <bpsim:CostParameters>
            <bpsim:FixedCost>
              <bpsim:FloatingParameter>
                <bpsim:Value>22</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:FixedCost>
          </bpsim:CostParameters>
          <bpsim:ResourceParameters>
            <bpsim:ResourceAssignmentExpression>
              <bpsim:Expression>
                <bpsim:StringParameter>
                  <bpsim:Value>Res_Risk</bpsim:Value>
                </bpsim:StringParameter>
              </bpsim:Expression>
            </bpsim:ResourceAssignmentExpression>
          </bpsim:ResourceParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="Task_Manual">
          <bpsim:TimeParameters>
            <bpsim:Duration>
              <bpsim:FloatingParameter>
                <bpsim:GammaDistribution scale="7.0" shape="7.0" />
              </bpsim:FloatingParameter>
            </bpsim:Duration>
          </bpsim:TimeParameters>
          <bpsim:CostParameters>
            <bpsim:FixedCost>
              <bpsim:FloatingParameter>
                <bpsim:Value>8</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:FixedCost>
          </bpsim:CostParameters>
          <bpsim:ResourceParameters>
            <bpsim:ResourceAssignmentExpression>
              <bpsim:Expression>
                <bpsim:StringParameter>
                  <bpsim:Value>Res_Manager</bpsim:Value>
                </bpsim:StringParameter>
              </bpsim:Expression>
            </bpsim:ResourceAssignmentExpression>
          </bpsim:ResourceParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="Task_Offer">
          <bpsim:TimeParameters>
            <bpsim:Duration>
              <bpsim:FloatingParameter>
                <bpsim:ErlangDistribution k="8" mean="4.0" />
              </bpsim:FloatingParameter>
            </bpsim:Duration>
          </bpsim:TimeParameters>
          <bpsim:CostParameters>
            <bpsim:FixedCost>
              <bpsim:FloatingParameter>
                <bpsim:Value>55</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:FixedCost>
          </bpsim:CostParameters>
          <bpsim:ResourceParameters>
            <bpsim:ResourceAssignmentExpression>
              <bpsim:Expression>
                <bpsim:StringParameter>
                  <bpsim:Value>Res_Risk</bpsim:Value>
                </bpsim:StringParameter>
              </bpsim:Expression>
            </bpsim:ResourceAssignmentExpression>
          </bpsim:ResourceParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="Task_Docs">
          <bpsim:TimeParameters>
            <bpsim:Duration>
              <bpsim:FloatingParameter>
                <bpsim:PoissonDistribution mean="7.0" />
              </bpsim:FloatingParameter>
            </bpsim:Duration>
          </bpsim:TimeParameters>
          <bpsim:CostParameters>
            <bpsim:FixedCost>
              <bpsim:FloatingParameter>
                <bpsim:Value>76</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:FixedCost>
          </bpsim:CostParameters>
          <bpsim:ResourceParameters>
            <bpsim:ResourceAssignmentExpression>
              <bpsim:Expression>
                <bpsim:StringParameter>
                  <bpsim:Value>Res_Manager</bpsim:Value>
                </bpsim:StringParameter>
              </bpsim:Expression>
            </bpsim:ResourceAssignmentExpression>
          </bpsim:ResourceParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="F_Approve">
          <bpsim:ControlParameters>
            <bpsim:Probability>
              <bpsim:FloatingParameter>
                <bpsim:Value>0.84</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:Probability>
          </bpsim:ControlParameters>
        </bpsim:ElementParameter>
        <bpsim:ElementParameter elementRef="F_Reject">
          <bpsim:ControlParameters>
            <bpsim:Probability>
              <bpsim:FloatingParameter>
                <bpsim:Value>0.16</bpsim:Value>
              </bpsim:FloatingParameter>
            </bpsim:Probability>
          </bpsim:ControlParameters>
        </bpsim:ElementParameter>
      </bpsim:ElementParameters>
      <bpsim:CalendarParameters>
        <bpsim:CalendarParameter calendarId="WORK_CAL" name="WORK_CAL">
          <bpsim:AvailableTime>
            <bpsim:Duration>P1W</bpsim:Duration>
            <bpsim:TimeTable>
              <bpsim:TimeSegment>
                <bpsim:StartingTime>P0DT7H0M0S</bpsim:StartingTime>
                <bpsim:Duration>PT11H</bpsim:Duration>
                <bpsim:WeekDay>MONDAY</bpsim:WeekDay>
              </bpsim:TimeSegment>
            </bpsim:TimeTable>
          </bpsim:AvailableTime>
        </bpsim:CalendarParameter>
      </bpsim:CalendarParameters>
    </bpsim:Scenario>
  </bpsim:BPSimData>
</definitions>
