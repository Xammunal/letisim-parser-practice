        <qbp:resourceIds>
          <qbp:resourceId>qbp_default_resource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
      <qbp:element id="qbp_da1968f4-5c11-4190-ab03-b392171ea97e" elementId="Task_Risk" fixedCost="0">
        <qbp:durationDistribution type="FIXED" mean="60" arg1="0" arg2="0" />
        <qbp:resourceIds>
          <qbp:resourceId>qbp_default_resource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
      <qbp:element id="qbp_2626587a-54b6-4f7c-b150-2acbad0f0499" elementId="Task_Manual" fixedCost="0">
        <qbp:durationDistribution type="FIXED" mean="60" arg1="0" arg2="0" />
        <qbp:resourceIds>
          <qbp:resourceId>qbp_default_resource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
      <qbp:element id="qbp_eec0b51b-7794-449b-9268-80057e138ca9" elementId="Task_Reject" fixedCost="0">
        <qbp:durationDistribution type="FIXED" mean="60" arg1="0" arg2="0" />
        <qbp:resourceIds>
          <qbp:resourceId>qbp_default_resource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
      <qbp:element id="qbp_feeb0fd2-46e1-48cd-a61f-977cd6a0d235" elementId="Task_Offer" fixedCost="0">
        <qbp:durationDistribution type="FIXED" mean="60" arg1="0" arg2="0" />
        <qbp:resourceIds>
          <qbp:resourceId>qbp_default_resource</qbp:resourceId>
        </qbp:resourceIds>
      </qbp:element>
    </qbp:elements>
    <qbp:sequenceFlows>
      <qbp:sequenceFlow elementId="F_Start_Docs" executionProbability="1.0" />
      <qbp:sequenceFlow elementId="F_Docs_Risk" executionProbability="1.0" />
      <qbp:sequenceFlow elementId="F_Risk_Decision" executionProbability="1.0" />
      <qbp:sequenceFlow elementId="F_Approve" executionProbability="0.84" />
      <qbp:sequenceFlow elementId="F_Reject" executionProbability="0.16" />
      <qbp:sequenceFlow elementId="F_Manual_Offer" executionProbability="1.0" />
