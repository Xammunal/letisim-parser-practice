<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
             exporter="ManualEditor"
             exporterVersion="1.0"
             id="Definitions_Extended_BPSim"
             targetNamespace="http://example.com/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <process id="Process_Extended_Simulation" name="Расширенный процесс кредитования" isExecutable="false">
    <startEvent id="StartEvent_1" name="Заявка получена">
      <outgoing>Flow_To_Parallel</outgoing>
    </startEvent>

    <parallelGateway id="Gateway_Parallel" name="Параллельная проверка">
      <incoming>Flow_To_Parallel</incoming>
      <outgoing>Flow_Check_History</outgoing>
      <outgoing>Flow_Wait_Timer</outgoing>
    </parallelGateway>

    <task id="Task_Check_History" name="Проверить кредитную историю">
      <incoming>Flow_Check_History</incoming>
      <outgoing>Flow_To_Merge</outgoing>
    </task>

    <intermediateCatchEvent id="Event_Timer_Wait" name="Ожидание справки (Таймер)">
      <incoming>Flow_Wait_Timer</incoming>
      <outgoing>Flow_After_Timer</outgoing>
      <timerEventDefinition>
        <timeDuration>P1D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <exclusiveGateway id="Gateway_Exclusive" name="Одобрено? (XOR)">
      <incoming>Flow_After_Timer</incoming>
      <incoming>Flow_From_Merge</incoming>
      <outgoing>Flow_Approve</outgoing>
      <outgoing>Flow_Reject</outgoing>
    </exclusiveGateway>

    <task id="Task_Manual_Approval" name="Ручное согласование менеджером">
      <incoming>Flow_Approve</incoming>
      <outgoing>Flow_To_End</outgoing>
    </task>

    <task id="Task_Reject" name="Отказать клиенту">
      <incoming>Flow_Reject</incoming>
      <outgoing>Flow_To_End</outgoing>
    </task>

    <endEvent id="EndEvent_1" name="Процесс завершен">
      <incoming>Flow_To_End</incoming>
    </endEvent>

    <sequenceFlow id="Flow_To_Parallel" sourceRef="StartEvent_1" targetRef="Gateway_Parallel" />
    <sequenceFlow id="Flow_Check_History" sourceRef="Gateway_Parallel" targetRef="Task_Check_History" />
    <sequenceFlow id="Flow_Wait_Timer" sourceRef="Gateway_Parallel" targetRef="Event_Timer_Wait" />
    <sequenceFlow id="Flow_After_Timer" sourceRef="Event_Timer_Wait" targetRef="Gateway_Exclusive" />
    <sequenceFlow id="Flow_To_Merge" sourceRef="Task_Check_History" targetRef="Gateway_Exclusive" />

    <sequenceFlow id="Flow_Approve" name="Да" sourceRef="Gateway_Exclusive" targetRef="Task_Manual_Approval">
      <conditionExpression xsi:type="tFormalExpression">0.8</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_Reject" name="Нет" sourceRef="Gateway_Exclusive" targetRef="Task_Reject">
      <conditionExpression xsi:type="tFormalExpression">0.2</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_To_End" sourceRef="Task_Manual_Approval" targetRef="EndEvent_1" />
    <sequenceFlow id="Flow_To_End_Rej" sourceRef="Task_Reject" targetRef="EndEvent_1" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="Process_Extended_Simulation" id="BPMNPlane_1">
      <bpmndi:BPMNShape bpmnElement="StartEvent_1" id="StartEvent_1_gui">
        <omgdc:Bounds height="30.0" width="30.0" x="100.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Gateway_Parallel" id="Gateway_Parallel_gui">
        <omgdc:Bounds height="40.0" width="40.0" x="180.0" y="95.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Check_History" id="Task_Check_History_gui">
        <omgdc:Bounds height="80.0" width="100.0" x="260.0" y="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Event_Timer_Wait" id="Event_Timer_Wait_gui">
        <omgdc:Bounds height="30.0" width="30.0" x="260.0" y="140.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Gateway_Exclusive" id="Gateway_Exclusive_gui">
        <omgdc:Bounds height="40.0" width="40.0" x="400.0" y="95.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Manual_Approval" id="Task_Manual_Approval_gui">
        <omgdc:Bounds height="80.0" width="100.0" x="480.0" y="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Reject" id="Task_Reject_gui">
        <omgdc:Bounds height="80.0" width="100.0" x="480.0" y="140.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_1" id="EndEvent_1_gui">
        <omgdc:Bounds height="30.0" width="30.0" x="620.0" y="100.0"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge bpmnElement="Flow_To_Parallel" id="Flow_To_Parallel_gui">
        <omgdi:waypoint x="130.0" y="115.0"/>
        <omgdi:waypoint x="180.0" y="115.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Check_History" id="Flow_Check_History_gui">
        <omgdi:waypoint x="200.0" y="95.0"/>
        <omgdi:waypoint x="200.0" y="90.0"/>
        <omgdi:waypoint x="260.0" y="90.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Wait_Timer" id="Flow_Wait_Timer_gui">
        <omgdi:waypoint x="200.0" y="135.0"/>
        <omgdi:waypoint x="200.0" y="155.0"/>
        <omgdi:waypoint x="260.0" y="155.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_After_Timer" id="Flow_After_Timer_gui">
        <omgdi:waypoint x="290.0" y="155.0"/>
        <omgdi:waypoint x="350.0" y="155.0"/>
        <omgdi:waypoint x="350.0" y="135.0"/>
        <omgdi:waypoint x="400.0" y="135.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_To_Merge" id="Flow_To_Merge_gui">
        <omgdi:waypoint x="360.0" y="90.0"/>
        <omgdi:waypoint x="400.0" y="90.0"/>
        <omgdi:waypoint x="400.0" y="95.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Approve" id="Flow_Approve_gui">
        <omgdi:waypoint x="420.0" y="95.0"/>
        <omgdi:waypoint x="420.0" y="90.0"/>
        <omgdi:waypoint x="480.0" y="90.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Reject" id="Flow_Reject_gui">
        <omgdi:waypoint x="420.0" y="135.0"/>
        <omgdi:waypoint x="420.0" y="180.0"/>
        <omgdi:waypoint x="480.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_To_End" id="Flow_To_End_gui">
        <omgdi:waypoint x="580.0" y="90.0"/>
        <omgdi:waypoint x="620.0" y="115.0"/>
      </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge bpmnElement="Flow_To_End_Rej" id="Flow_To_End_Rej_gui">
        <omgdi:waypoint x="580.0" y="180.0"/>
        <omgdi:waypoint x="635.0" y="180.0"/>
        <omgdi:waypoint x="635.0" y="130.0"/>
        <omgdi:waypoint x="620.0" y="130.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpsim:Scenario id="Scenario_Extended" name="Расширенный сценарий BPSim">

    <bpsim:ScenarioParameters id="ScenarioParams_1"
                              processInstances="100"
                              beginEvent="StartEvent_1"
                              baseCurrency="EUR">
        <bpsim:RandomSeed>12345</bpsim:RandomSeed>
    </bpsim:ScenarioParameters>

    <bpsim:CalendarParameters id="CalParams_Default">
        <bpsim:CalendarId>DEFAULT_TIMETABLE</bpsim:CalendarId>
        <bpsim:AvailableTime>
            <bpsim:Duration>P1W</bpsim:Duration>
            <bpsim:TimeTable>
                <bpsim:TimeSegment startTime="PT9H" duration="PT9H">
                    <bpsim:WeekDay>MONDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>TUESDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>WEDNESDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>THURSDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>FRIDAY</bpsim:WeekDay>
                </bpsim:TimeSegment>
            </bpsim:TimeTable>
        </bpsim:AvailableTime>
    </bpsim:CalendarParameters>

    <bpsim:CalendarParameters id="CalParams_Extended">
        <bpsim:CalendarId>EXTENDED_TIMETABLE</bpsim:CalendarId>
        <bpsim:AvailableTime>
            <bpsim:Duration>P1W</bpsim:Duration>
            <bpsim:TimeTable>
                <bpsim:TimeSegment startTime="PT8H" duration="PT12H">
                    <bpsim:WeekDay>MONDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>TUESDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>WEDNESDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>THURSDAY</bpsim:WeekDay>
                    <bpsim:WeekDay>FRIDAY</bpsim:WeekDay>
                </bpsim:TimeSegment>
            </bpsim:TimeTable>
        </bpsim:AvailableTime>
    </bpsim:CalendarParameters>

    <bpsim:ResourceParameters id="ResParams_Clerk">
        <bpsim:ResourceId>Res_Clerk</bpsim:ResourceId>
        <bpsim:ResourceName>Clerk</bpsim:ResourceName>
        <bpsim:Amount>
            <bpsim:ParameterValue>
                <bpsim:FixedValue>2</bpsim:FixedValue>
            </bpsim:ParameterValue>
        </bpsim:Amount>
        <bpsim:CostPerHour>
            <bpsim:ParameterValue>
                <bpsim:FixedValue>20.0</bpsim:FixedValue>
            </bpsim:ParameterValue>
        </bpsim:CostPerHour>
        <bpsim:CalendarRef>DEFAULT_TIMETABLE</bpsim:CalendarRef>
    </bpsim:ResourceParameters>

    <bpsim:ResourceParameters id="ResParams_Manager">
        <bpsim:ResourceId>Res_Manager</bpsim:ResourceId>
        <bpsim:ResourceName>Manager</bpsim:ResourceName>
        <bpsim:Amount>
            <bpsim:ParameterValue>
                <bpsim:FixedValue>1</bpsim:FixedValue>
            </bpsim:ParameterValue>
        </bpsim:Amount>
        <bpsim:CostPerHour>
            <bpsim:ParameterValue>
                <bpsim:FixedValue>50.0</bpsim:FixedValue>
            </bpsim:ParameterValue>
        </bpsim:CostPerHour>
        <bpsim:CalendarRef>EXTENDED_TIMETABLE</bpsim:CalendarRef>
    </bpsim:ResourceParameters>

    <bpsim:ElementParameters id="ElemParams_CheckHistory" elementRef="Task_Check_History">
        <bpsim:TimeParameters>
            <bpsim:Duration>
                <bpsim:ParameterValue>
                    <bpsim:NormalDistribution mean="300.0" standardDeviation="60.0"/>
                </bpsim:ParameterValue>
            </bpsim:Duration>
        </bpsim:TimeParameters>
        <bpsim:CostParameters>
            <bpsim:UnitCost>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>5.0</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:UnitCost>
        </bpsim:CostParameters>
        <bpsim:ResourceAssignmentExpression>
            <bpsim:Expression>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>Res_Clerk</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Expression>
        </bpsim:ResourceAssignmentExpression>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="ElemParams_TimerWait" elementRef="Event_Timer_Wait">
        <bpsim:TimeParameters>
            <bpsim:Duration>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>86400.0</bpsim:FixedValue> <!-- 1 день в секундах -->
                </bpsim:ParameterValue>
            </bpsim:Duration>
        </bpsim:TimeParameters>
        <bpsim:CostParameters>
            <bpsim:UnitCost>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>0.0</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:UnitCost>
        </bpsim:CostParameters>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="ElemParams_ManualApproval" elementRef="Task_Manual_Approval">
        <bpsim:TimeParameters>
            <bpsim:Duration>
                <bpsim:ParameterValue>
                    <bpsim:NormalDistribution mean="1200.0" standardDeviation="300.0"/>
                </bpsim:ParameterValue>
            </bpsim:Duration>
        </bpsim:TimeParameters>
        <bpsim:CostParameters>
            <bpsim:UnitCost>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>10.0</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:UnitCost>
        </bpsim:CostParameters>
        <bpsim:ResourceAssignmentExpression>
            <bpsim:Expression>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>Res_Manager</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Expression>
        </bpsim:ResourceAssignmentExpression>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="ElemParams_Reject" elementRef="Task_Reject">
        <bpsim:TimeParameters>
            <bpsim:Duration>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>10.0</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Duration>
        </bpsim:TimeParameters>
        <bpsim:CostParameters>
            <bpsim:UnitCost>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>0.0</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:UnitCost>
        </bpsim:CostParameters>
        <bpsim:ResourceAssignmentExpression>
            <bpsim:Expression>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>Res_Clerk</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Expression>
        </bpsim:ResourceAssignmentExpression>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="ElemParams_XOR" elementRef="Gateway_Exclusive">
        <bpsim:ControlParameters>
            <bpsim:Probability>
            </bpsim:Probability>
        </bpsim:ControlParameters>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="FlowParams_Approve" elementRef="Flow_Approve">
        <bpsim:ControlParameters>
            <bpsim:Probability>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>0.8</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Probability>
        </bpsim:ControlParameters>
    </bpsim:ElementParameters>

    <bpsim:ElementParameters id="FlowParams_Reject" elementRef="Flow_Reject">
        <bpsim:ControlParameters>
            <bpsim:Probability>
                <bpsim:ParameterValue>
                    <bpsim:FixedValue>0.2</bpsim:FixedValue>
                </bpsim:ParameterValue>
            </bpsim:Probability>
        </bpsim:ControlParameters>
    </bpsim:ElementParameters>

  </bpsim:Scenario>

</definitions>